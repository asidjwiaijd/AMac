# Preserve upstream bytes, including whitespace in generated/vendor headers.
third_party/esp_hosted_2_12_3/** text eol=lf -whitespace
# Netlist exports are hardware evidence; preserve their exported whitespace.
hardware/netlists/*.tel -whitespace
# Keep the supplied display reference byte-for-byte (it contains CRCRLF).
hardware/reference/tspi-rk3566-dsi-v10.dtsi -text -whitespace
# The Unix Basilisk II preferences reader strips LF only.
examples/amac-desktop/basilisk_ii_prefs text eol=lf
examples/amac-desktop/birthday_bridge.* text eol=lf
examples/amac-desktop/birthday_desktop_control.cpp text eol=lf
guest/birthday/dist/*.bin -text
# Preserve PDF byte offsets even when ASCII85 streams resemble plain text.
output/pdf/*.pdf -text -diff
scripts/build_amac_desktop.sh text eol=lf
scripts/install_birthday_desktop.sh text eol=lf
scripts/prepare_amac_browser.sh text eol=lf
scripts/run_amac_browser.sh text eol=lf
test/aot_host/*.sh text eol=lf
