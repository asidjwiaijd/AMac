  "cards": [
    {
      "dot": "cyan",
      "title": "读取顺序",
      "items": [
        "从 main.cpp 看启动，再看 main_esp32.cpp 的模拟运行。",
        "代码图标出主要调用和数据关系，不展开全部函数。"
      ]
    },
    {
      "dot": "violet",
      "title": "并发边界",
      "items": [
        "Core 0 处理输入、显示和控制协议；Core 1 执行 68K。",
        "请求通过队列、安全 CPU 边界和脏块快照交接。"
      ]
    },
    {
      "dot": "amber",
      "title": "修改入口",
      "items": [
        "换硬件看 src/board/amac/；改交互看 tools/ 与 input_esp32。",
        "guest/birthday/ 为 Mac 磁盘里的 68K 入口，固件负责彩蛋绘制。"
      ]
    }
